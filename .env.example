# ============================================
# 环境变量配置示例文件
# 复制此文件为 .env 或 .env.production 并填入实际值
# ============================================

# ============================================
# PostgreSQL 配置（Guestbook + Better Auth）
# 生产环境使用共享 infra 的 PostgreSQL，一个应用一个库/角色
# ============================================
DATABASE_URL=postgresql://app_user:[YOUR-PASSWORD]@127.0.0.1:5432/app_db

# ============================================
# Redis 配置（博客缓存等）
# ============================================
REDIS_URL=redis://:[YOUR-PASSWORD]@127.0.0.1:6379/0

# ============================================
# Better Auth 配置
# ============================================
# 注意：BETTER_AUTH_URL 必须与实际访问协议严格一致（生产上 HTTPS 则必须 https://）
# Better Auth 会以此值生成 OAuth 回调 URL、校验 origin、决定 Cookie 的 Secure 标志
BETTER_AUTH_URL=http://localhost:3000
# 生产环境必填，不使用默认值；生成命令：`openssl rand -base64 32`
BETTER_AUTH_SECRET=

# ============================================
# GitHub OAuth 配置（用于用户登录，可选）
# ============================================
# 注意：使用 AUTH_GITHUB_ 前缀避免与 GitHub Actions 的系统变量冲突
# 如果不需要 GitHub 登录功能，可以留空
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# ============================================
# GitHub App 配置（用于访问私有仓库）
# ============================================
APP_ID=
APP_PEM_KEY_BASE64=
APP_INSTALLATION_ID=

# ============================================
# SMTP 邮件配置（联系表单）
# ============================================
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# ============================================
# Dev.to API 配置
# ============================================
DEVTO_KEY=

# ============================================
# Spotify API 配置
# ============================================
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# ============================================
# Wakatime API 配置
# ============================================
WAKATIME_API_KEY=

# ============================================
# Blog API 配置
# ============================================
BLOG_API_URL=
